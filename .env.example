# Copy to .env.local for local testing, or set in Vercel → Project → Settings → Environment Variables

# Your public URL after deploy (e.g. https://consult-pollution.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Google AdSense (after approval): Publisher ID ca-pub-xxxxxxxx
NEXT_PUBLIC_ADSENSE_CLIENT=

# Ad unit slot IDs from AdSense dashboard (optional until approved)
NEXT_PUBLIC_AD_SLOT_TOP=
NEXT_PUBLIC_AD_SLOT_RESULT=

# Optional: ads.txt line (pub-xxx). Auto-derived from ca-pub- if omitted.
ADSENSE_PUBLISHER_ID=
